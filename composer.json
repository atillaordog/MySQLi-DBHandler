{
    "name": "dbhandler/dbhandler",
    "description": "A small mysqli based database handler that runs every query as a prepared statement",
    "type": "library",
    "keywords": ["mysqli", "database", "mysql", "prepared statements"],
    "license": "MIT",
    "authors": [
        {
            "name": "Atilla Ördög",
            "email": "attila.ordog@yahoo.com",
            "homepage": "http://www.gadratilprogramming.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-mysqli": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "DBHandler\\": "src/"
        },
        "files": [
            "src/aliases.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "DBHandler\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
